{
  "name": "zn-client",
  "version": "0.1.4",
  "description": "Un launcher ligero para Minecraft Java Edition.",
  "main": "src/main.js",
  "author": "zN Client",
  "license": "UNLICENSED",
  "scripts": {
    "start": "npm run build-client-mod && electron .",
    "build-client-mod": "node scripts/build-client-mod.js",
    "prepare-runtime": "node scripts/prepare-runtime.js",
    "dist": "npm run prepare-runtime && npm run build-client-mod && electron-builder --win nsis",
    "release": "npm run prepare-runtime && npm run build-client-mod && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "adm-zip": "^0.4.16",
    "electron-updater": "^6.8.11",
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.znclient.launcher",
    "productName": "zN Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "zNClient.png",
      "zNClient.ico",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/java-runtime",
        "to": "java-runtime"
      },
      {
        "from": "build/client-mods",
        "to": "client-mods"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "zNicoojk",
      "repo": "zN-Client",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "zNClient.ico",
      "artifactName": "zN-Client-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "zNClient.ico",
      "uninstallerIcon": "zNClient.ico"
    }
  }
}
